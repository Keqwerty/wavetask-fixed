# Local build of the current working tree, including uncommitted changes.
# Use with: makepkg -p PKGBUILD.local -si

_pkgname=wavetask
pkgname="$_pkgname-git"
pkgver=1.4.r33.gfb5938e.local
pkgrel=1
pkgdesc="A Plasma 6 task manager plasmoid with zoom effect (macOS Dock skin)"
arch=('x86_64')
url="https://github.com/Keqwerty/wavetask-fixed"
license=('GPL-3.0-or-later')

depends=(
  'qt6-base'
  'qt6-declarative'
  'ki18n'
  'kservice'
  'kwindowsystem'
  'kconfig'
  'kconfigwidgets'
  'knotifications'
  'kio'
  'kcoreaddons'
  'kitemmodels'
  'libplasma'
  'plasma-activities'
  'plasma-activities-stats'
  'plasma-pa'
  'plasma-workspace'
  'plasma-desktop'
  'libksysguard'
  'kwin'
  'libepoxy'
  'libdrm'
)

makedepends=(
  'git'
  'cmake'
  'extra-cmake-modules'
  'gcc'
  'vulkan-headers'
)

conflicts=("$_pkgname")
provides=("$_pkgname=$pkgver")

# Do not clone a branch: that silently drops fixes in the working tree.
source=()
sha256sums=()

options=('!debug')

pkgver() {
  printf '1.4.r%s.g%s.local' "$(git -C "$startdir" rev-list --count HEAD)" "$(git -C "$startdir" rev-parse --short=7 HEAD)"
}

build() {
  cmake -B "$srcdir/build-local" -S "$startdir/wavetask-source" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$srcdir/build-local" -j"$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-local"
}
